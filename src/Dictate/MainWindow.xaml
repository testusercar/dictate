<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dictate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Dictate">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drawn on Mica; caption buttons stay system-drawn. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Square44x44Logo.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Dictate" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="1000" Padding="36,8,36,36" Spacing="4" HorizontalAlignment="Stretch">

                <TextBlock Text="Dictate" Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- How to use it, and what state it's in right now. -->
                <Border Padding="20" Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" FontSize="32" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Hold the Copilot key and talk, then let go. Double tap it for hands-free and tap again to finish. Esc cancels."
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="KeyBar" IsClosable="False" />
                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Last problem" IsClosable="True" />

                <!-- Speech engine -->
                <TextBlock Text="Speech engine" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Transcribe with"
                                 Description="On this PC keeps your voice private and works offline. Grok runs in xAI's cloud and needs an API key.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="EngineBox" MinWidth="200" SelectionChanged="EngineBox_SelectionChanged">
                        <ComboBoxItem Content="On this PC (Parakeet)" Tag="Local" />
                        <ComboBoxItem Content="Grok (xAI cloud)" Tag="Grok" />
                    </ComboBox>
                </tk:SettingsCard>

                <tk:SettingsCard x:Name="ModelCard" Header="Local speech model"
                                 Description="NVIDIA Parakeet TDT 0.6B v3: 25 European languages with punctuation. A 490 MB download, then it runs offline.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressBar x:Name="ModelProgress" Width="160" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
                        <TextBlock x:Name="ModelState" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ModelButton" Click="ModelButton_Click" />
                    </StackPanel>
                </tk:SettingsCard>
                <InfoBar x:Name="ModelBar" Severity="Error" IsClosable="True" />

                <!-- Grok -->
                <TextBlock Text="Grok" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsExpander x:Name="ApiKeyExpander" Header="xAI API key" IsExpanded="True"
                                     Description="Dictation is sent to xAI's speech-to-text. Billed to your xAI account at about $0.20 per hour of audio.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="ApiKeyState" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <PasswordBox x:Name="ApiKeyBox" PlaceholderText="xai-…" MinWidth="320"
                                             KeyDown="ApiKeyBox_KeyDown" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveKeyButton" Content="Save" Style="{StaticResource AccentButtonStyle}"
                                            Click="SaveKey_Click" />
                                    <Button x:Name="TestKeyButton" Content="Test connection" Click="TestKey_Click" />
                                    <Button x:Name="RemoveKeyButton" Content="Remove" Click="RemoveKey_Click" />
                                    <ProgressRing x:Name="TestRing" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                                <HyperlinkButton Content="Create a key in the xAI console" Padding="0"
                                                 NavigateUri="https://console.x.ai/" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <InfoBar x:Name="TestBar" IsClosable="True" />

                <tk:SettingsCard Header="Language"
                                 Description="Picking your language lets Grok format numbers and dates. Auto-detect works for mixed languages.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageBox" MinWidth="180" SelectionChanged="LanguageBox_SelectionChanged" />
                </tk:SettingsCard>

                <!-- Microphone -->
                <TextBlock Text="Microphone" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Catch the first words"
                                 Description="Keeps the microphone open in the background so nothing is lost while Windows waits to see that you're holding the key. Audio stays in memory and is thrown away unless you dictate. The microphone-in-use icon stays on.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE1D6;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="WarmMicSwitch" Toggled="WarmMicSwitch_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsCard Header="Microphone privacy" Description="Choose which microphone Windows uses, and allow Dictate to use it."
                                 IsClickEnabled="True" Click="MicPrivacy_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <!-- Copilot key -->
                <TextBlock Text="Copilot key" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard x:Name="CopilotKeyCard" Header="Customize Copilot key"
                                 Description="Choose Dictate under Personalization > Text input."
                                 IsClickEnabled="True" Click="CopilotKeySettings_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <!-- General -->
                <TextBlock Text="General" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Start with Windows"
                                 Description="Run Dictate in the background when you sign in, so the first press of the key is instant.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupSwitch" Toggled="StartupSwitch_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsExpander Header="Last dictation" Description="What Dictate heard most recently.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Content="Copy" Click="CopyLast_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <TextBlock x:Name="LastText" Text="Nothing yet." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="Diagnostics" Description="Key presses, timings and errors from this session.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Content="Copy log" Click="CopyLog_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <ListView x:Name="LogList" MaxHeight="280" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsCard Header="Quit Dictate"
                                 Description="Closing this window keeps Dictate running for the Copilot key. Quit stops it until you open it again.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button Content="Quit" Click="Quit_Click" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
