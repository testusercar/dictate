<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dictate.RecordingPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dictate">

    <Grid x:Name="Root" Padding="14,0,20,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Mic glyph with a halo that follows the input level. -->
        <Grid Width="32" Height="32" VerticalAlignment="Center">
            <Ellipse x:Name="LevelHalo" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.25"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="LevelScale" ScaleX="0.6" ScaleY="0.6" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <FontIcon x:Name="MicGlyph" Glyph="&#xE720;" FontSize="16"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <FontIcon x:Name="ErrorGlyph" Glyph="&#xE783;" FontSize="18" Visibility="Collapsed"
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <ProgressRing x:Name="Busy" Width="28" Height="28" IsActive="False" />
        </Grid>

        <TextBlock x:Name="ModeText" Grid.Column="1" Text="Listening" VerticalAlignment="Center"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <TextBlock x:Name="TranscriptText" Grid.Column="2" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
