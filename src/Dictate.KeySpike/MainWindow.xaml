<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dictate.KeySpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dictate: Copilot key test">

    <Grid x:Name="Root" Padding="24" RowSpacing="12" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="Hold the Copilot key to talk. Double tap for hands-free. Esc cancels." TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="State:" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="StateText" Text="Idle" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="RegistrationBar" IsOpen="True" IsClosable="False" />

        <ListView Grid.Row="3" x:Name="LogList" SelectionMode="None"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="Copy log" Click="CopyLog_Click" />
            <Button Content="Clear" Click="Clear_Click" />
            <Button Content="Open Copilot key settings" Click="OpenSettings_Click" />
        </StackPanel>
    </Grid>
</Window>
