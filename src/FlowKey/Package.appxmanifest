<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <!-- Publisher must match the subject of the signing certificate (see scripts/New-DevCert.ps1).
       The name stays FlowKey so an existing Copilot key choice (FlowKey_...!App) keeps working. -->
  <Identity Name="FlowKey" Publisher="CN=Dictate Dev" Version="0.1.0.0" />

  <Properties>
    <DisplayName>Copilot Key Launcher</DisplayName>
    <PublisherDisplayName>Dictate</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Copilot Key Launcher"
        Description="Opens the app you choose with the Copilot key."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="flowkey">
            <uap:DisplayName>Copilot Key Launcher key events</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Makes the launcher selectable in Settings > Personalization > Text input > Customize Copilot key.
             No MessageWParam (fast path): every press is a flowkey:// launch, which opens the chosen
             app and exits without a window, so nothing needs to keep running in the background. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.copilotkeyprovider"
            Id="FlowKey"
            DisplayName="Copilot Key Launcher"
            Description="Opens the app you choose"
            PublicFolder="Public">
            <uap3:Properties>
              <SingleTap>flowkey://?state=Tap</SingleTap>
              <PressAndHoldStart>flowkey://?state=Down</PressAndHoldStart>
              <PressAndHoldStop>flowkey://?state=Up</PressAndHoldStop>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
