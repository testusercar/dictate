<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlowKey.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Copilot Key Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drawn on Mica; caption buttons stay system-drawn. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Square44x44Logo.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Copilot Key Launcher" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="1000" Padding="36,8,36,36" Spacing="4" HorizontalAlignment="Stretch">

                <TextBlock Text="Copilot Key Launcher" Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" />

                <Border Padding="20" Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" FontSize="32" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="StatusText" Text="No app chosen" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Press the Copilot key to open the app you choose here, or bring it back if it's already open. Nothing else shows up in between: the launcher starts, opens the app and exits."
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="KeyBar" IsClosable="False" />

                <!-- App -->
                <TextBlock Text="App" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Open with the Copilot key"
                                 Description="Any app in the Start menu's All apps list.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="AppBox" MinWidth="260" PlaceholderText="Loading apps..."
                              IsEnabled="False" SelectionChanged="AppBox_SelectionChanged" />
                </tk:SettingsCard>

                <tk:SettingsCard Header="Try it" Description="Opens the app now, the same way the Copilot key does.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button x:Name="OpenButton" Content="Open" Click="Open_Click" />
                </tk:SettingsCard>

                <!-- Copilot key -->
                <TextBlock Text="Copilot key" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard x:Name="CopilotKeyCard" Header="Customize Copilot key"
                                 Description="Choose Copilot Key Launcher under Personalization > Text input."
                                 IsClickEnabled="True" Click="CopilotKeySettings_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <!-- General -->
                <TextBlock Text="General" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsExpander x:Name="DiagnosticsExpander" Header="Diagnostics"
                                     Description="Each Copilot key press, what it opened and how long that took.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Content="Copy log" Click="CopyLog_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <ListView x:Name="LogList" MaxHeight="280" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
