<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlowKey.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="Flow Key">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drawn on Mica; caption buttons stay system-drawn. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Square44x44Logo.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Flow Key" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="1000" Padding="36,8,36,36" Spacing="4" HorizontalAlignment="Stretch">

                <TextBlock Text="Flow Key" Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" />

                <Border Padding="20" Margin="0,0,0,8" CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" FontSize="32" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Hold the Copilot key to talk to Wispr Flow, then let go. Double tap it for hands-free and tap again to finish. Flow Key only presses Wispr Flow's shortcuts; Wispr Flow does the listening and typing."
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="KeyBar" IsClosable="False" />

                <!-- Shortcuts -->
                <TextBlock Text="Wispr Flow shortcuts" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard x:Name="PushToTalkCard" Header="Push to talk">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE720;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="PushToTalkBox" MinWidth="200" SelectionChanged="PushToTalkBox_SelectionChanged" />
                </tk:SettingsCard>

                <tk:SettingsCard x:Name="HandsFreeCard" Header="Hands-free">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="HandsFreeBox" MinWidth="200" SelectionChanged="HandsFreeBox_SelectionChanged" />
                </tk:SettingsCard>

                <!-- Copilot key -->
                <TextBlock Text="Copilot key" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard x:Name="CopilotKeyCard" Header="Customize Copilot key"
                                 Description="Choose Wispr Flow (via Flow Key) under Personalization > Text input."
                                 IsClickEnabled="True" Click="CopilotKeySettings_Click">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <!-- General -->
                <TextBlock Text="General" Margin="1,24,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <tk:SettingsCard Header="Start with Windows"
                                 Description="Run Flow Key in the background when you sign in. The Copilot key only reaches Wispr Flow while Flow Key runs.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupSwitch" Toggled="StartupSwitch_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsExpander Header="Diagnostics" Description="Key presses and the shortcuts sent, with timings.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Content="Copy log" Click="CopyLog_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <ListView x:Name="LogList" MaxHeight="280" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsCard Header="Quit Flow Key"
                                 Description="Closing this window keeps Flow Key running for the Copilot key. Quit stops it until you open it again.">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button Content="Quit" Click="Quit_Click" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
